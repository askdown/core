{
  "name": "@askdown/core",
  "version": "0.3.0",
  "private": true,
  "description": "Parser, serializer and validator for Askdown, a Markdown-like language for forms.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/askdown/core.git"
  },
  "homepage": "https://askdown.dev",
  "exports": {
    ".": "./src/index.ts"
  },
  "keywords": [
    "forms",
    "markdown",
    "dsl",
    "askdown",
    "survey"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "release": "sh scripts/publish.sh"
  },
  "devDependencies": {
    "@askdown/spec": "^0.3.1",
    "@types/node": "^24.13.6",
    "ajv": "^8.20.0",
    "typescript": "^7.0.2",
    "vitest": "~4.1.0"
  }
}
